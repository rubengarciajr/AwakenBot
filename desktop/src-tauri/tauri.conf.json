{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AwakenBot",
  "version": "../../package.json",
  "identifier": "org.awakenbot.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3020",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "AwakenBot",
        "width": 1000,
        "height": 800,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "titleBarStyle": "Transparent",
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "entitlements": "./Entitlements.plist"
    },
    "windows": {
      "nsis": {
        "template": "./windows/installer.nsi",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["English"],
        "customLanguageFiles": {
          "English": "./windows/installer-english.nsh"
        },
        "installerIcon": "./icons/icon.ico",
        "uninstallerIcon": "./icons/icon.ico",
        "headerImage": "./windows/installer-header.bmp",
        "sidebarImage": "./windows/installer-sidebar.bmp"
      }
    },
    "linux": {
      "deb": {
        "depends": ["pkexec", "procps", "lsof", "ca-certificates"],
        "postRemoveScript": "./linux/remove.sh"
      },
      "rpm": {
        "depends": [
          "/usr/bin/pkexec",
          "/usr/bin/ps",
          "/usr/bin/lsof",
          "ca-certificates"
        ],
        "postRemoveScript": "./linux/remove.sh"
      }
    },
    "targets": ["dmg", "nsis", "appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "AwakenBot",
    "copyright": "AwakenBot. Built on CopilotKit/OpenBot (MIT License).",
    "category": "Productivity",
    "shortDescription": "Run AwakenBot on your own computer",
    "longDescription": "AwakenBot Desktop installs the container engine, raises the stack, and keeps it running."
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["openbot"]
      }
    }
  }
}
